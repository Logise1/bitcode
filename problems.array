        "testCode": "results = []\ntests = [(\"aab\", [[\"a\", \"a\", \"b\"], [\"aa\", \"b\"]]), (\"a\", [[\"a\"]])]\n\n# Helper para comparar listas de listas ignorando orden\ndef compare_lists_of_lists(list1, list2):\n    if len(list1) != len(list2): return False\n    set1 = set(tuple(sublist) for sublist in list1)\n    set2 = set(tuple(sublist) for sublist in list2)\n    return set1 == set2\n\nfor i, (arg, expected) in enumerate(tests):\n    try:\n        result = solve(arg)\n        if compare_lists_of_lists(result, expected):\n            results.append(f\"Test {i+1}: <span class='text-green-400'>PASSED</span>\")\n        else:\n            raise Exception(f\"Resultado incorrecto. Se esperaba {expected} (en cualquier orden), pero se obtuvo {result}\")\n    except Exception as e:\n        results.append(f\"Test {i+1}: <span class='text-red-400'>FAILED</span> - {e}\")\n\nif all(\"<span class'text-green-400'>PASSED</span>\" in res for res in results):\n    print(\"__SUCCESS__\")\nelse:\n    print(\"__FAILURE__:\\n\" + \"\\n\".join(results))\n"
    },
